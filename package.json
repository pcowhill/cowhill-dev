{
  "name": "cowhill-dev",
  "version": "0.1.0",
  "private": true,
  "description": "cowhill.dev: a personal project catalog built with Astro.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run brand && astro dev",
    "build": "npm run brand && astro build",
    "preview": "astro preview",
    "brand": "node scripts/generate-brand.ts",
    "validate": "node scripts/validate.ts",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "editor:build": "node scripts/build-editor.ts",
    "editor:check": "node scripts/build-editor.ts --check",
    "inspect-dist": "node scripts/inspect-dist.ts",
    "check:pages-config": "node scripts/check-pages-config.ts",
    "verify": "npm run validate && npm run editor:check && npm run typecheck && npm run test && npm run build && npm run inspect-dist"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "marked": "^18.0.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
