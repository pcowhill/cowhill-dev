---
import { resolveDeployment, site } from '../config/site.ts';
import { routes } from '../shared/paths.ts';
import { renderAnchor } from '../shared/links.ts';
import { getPortfolioLink } from '../data/projects.ts';

const { origin, base } = resolveDeployment(process.env);
const portfolio = getPortfolioLink();
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__text">© {year} {site.author}. {site.name} is a personal project catalog.</p>
    <ul class="site-footer__links">
      <li><a href={routes.projects(base)}>Projects</a></li>
      <li><a href={routes.about(base)}>About</a></li>
      {portfolio ? <li set:html={renderAnchor(portfolio.href, 'Portfolio', { origin, base }).value} /> : null}
    </ul>
  </div>
</footer>
