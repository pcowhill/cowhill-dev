---
import Base from '../layouts/Base.astro';
import { resolveDeployment } from '../config/site.ts';
import { aboutDescription, aboutParagraphs, aboutTitle } from '../content/about.ts';
import { getPortfolioLink } from '../data/projects.ts';
import { escapeHtml } from '../shared/html.ts';
import { renderAnchor } from '../shared/links.ts';

const { origin, base } = resolveDeployment(process.env);
const portfolio = getPortfolioLink();

function renderParagraph(text: string): string {
  return text.replace(/\{portfolio:([^}]+)\}|([^{]+)|(\{)/g, (match, linkText: string | undefined, plain: string | undefined) => {
    if (linkText !== undefined) {
      return portfolio ? renderAnchor(portfolio.href, linkText, { origin, base }).value : escapeHtml(linkText);
    }
    return escapeHtml(plain ?? match);
  });
}
const paragraphs = aboutParagraphs.map(renderParagraph);
---

<Base title={aboutTitle} description={aboutDescription} path="about/" current="about">
  <div class="page-header">
    <h1>{aboutTitle}</h1>
  </div>
  <div class="about">
    {paragraphs.map((html) => <p set:html={html} />)}
  </div>
</Base>
